# ==============================================================================
# Ragnarok M: Eternal Love (LouLx + SkyArc Merged Stack) - Environment Config
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# Server IP expected by the LouLx mobile client.
# The server stack binds to 0.0.0.0 and connects internally via localhost/Docker network.
# Set VMnet8 on your host Windows PC to 192.168.128.129 (mask 255.255.255.0).
SERVER_IP=192.168.128.129

# MySQL Credentials
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ro_global
MYSQL_PORT=3306

# Redis Settings
REDIS_PORT=6379

# Web Services & Port Forwarding
WEB_PORT_HTTP=33061
WEB_PORT_PORTAL=81
WEB_PORT_API=5556
EQUIPMENT_SHOP_ENABLED=true

# Core Game Server Ports
GATEWAY_PORT_1=7080
GATEWAY_PORT_2=7081
GATEWAY_PORT_3=7082
SUPER_SERVER_PORT=7050

# Exchange (Trade Server) Ports
TRADE_SERVER_PORT=6091
TRADE_SERVER_PORT_ALT=26091

# Proxy Ports
PROXY_PORT_1=12053
PROXY_PORT_2=14288
